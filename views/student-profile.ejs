<%- include('shell-start') %>
<div class="page-heading"><div><a class="back-link" href="/students"><i data-lucide="arrow-left"></i> Student records</a><span class="eyebrow">STUDENT PROFILE</span><h1>Student profile</h1><p>Personal and academic record details.</p></div><div class="heading-actions"><a class="button button-secondary" href="/students/<%= student.id %>/edit"><i data-lucide="pencil"></i> Edit profile</a><form action="/students/<%= student.id %>/delete" method="post" data-confirm-delete><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-soft" type="submit"><i data-lucide="trash-2"></i> Delete</button></form></div></div>
<section class="profile-hero panel"><span class="avatar avatar-profile"><% if (student.has_profile_photo) { %><img class="avatar-image" src="/students/<%= student.id %>/photo" alt="Profile photo of <%= student.first_name %> <%= student.last_name %>"><% } else { %><%= student.first_name.slice(0, 1) %><%= student.last_name.slice(0, 1) %><% } %></span><div class="profile-title"><span class="eyebrow">STUDENT ID · <%= student.student_id %></span><h2><%= student.first_name %> <%= student.middle_name ? student.middle_name + ' ' : '' %><%= student.last_name %></h2><p><%= student.course_name || 'Course not assigned' %><span class="profile-divider">·</span><%= student.year_level %><%= student.section ? ' · Section ' + student.section : '' %></p></div></section>
<div class="profile-grid">
  <section class="panel detail-panel"><div class="panel-heading"><div class="detail-heading"><span class="section-icon icon-blue"><i data-lucide="user-round"></i></span><span><h3>Personal information</h3><p>Student identity details</p></span></div></div><dl class="detail-list"><div><dt>First name</dt><dd><%= student.first_name %></dd></div><div><dt>Middle name</dt><dd><%= student.middle_name || '—' %></dd></div><div><dt>Last name</dt><dd><%= student.last_name %></dd></div><div><dt>Gender</dt><dd><%= student.gender %></dd></div><div><dt>Date of birth</dt><dd><%= student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString() : '—' %></dd></div><div><dt>Student ID</dt><dd><span class="id-badge"><%= student.student_id %></span></dd></div></dl></section>
  <section class="panel detail-panel"><div class="panel-heading"><div class="detail-heading"><span class="section-icon icon-sky"><i data-lucide="contact"></i></span><span><h3>Contact information</h3><p>Student contact details</p></span></div></div><dl class="detail-list"><div><dt>Email address</dt><dd><a href="mailto:<%= student.email %>"><%= student.email %></a></dd></div><div><dt>Contact number</dt><dd><%= student.phone || '—' %></dd></div><div class="detail-span"><dt>Home address</dt><dd><%= student.address || '—' %></dd></div></dl></section>
  <section class="panel detail-panel detail-span"><div class="panel-heading"><div class="detail-heading"><span class="section-icon icon-violet"><i data-lucide="book-open"></i></span><span><h3>Academic information</h3><p>Program and enrollment details</p></span></div></div><dl class="detail-list detail-list-four"><div><dt>Course</dt><dd><%= student.course_name || 'Unassigned' %></dd></div><div><dt>Year level</dt><dd><span class="soft-badge"><%= student.year_level %></span></dd></div><div><dt>Section</dt><dd><%= student.section || '—' %></dd></div><div><dt>Enrollment date</dt><dd><%= new Date(student.enrollment_date).toLocaleDateString() %></dd></div></dl></section>
</div>
<%- include('shell-end') %>
