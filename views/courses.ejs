<%- include('shell-start') %>
<div class="page-heading"><div><span class="eyebrow">ACADEMIC PROGRAMS</span><h1>Course management</h1><p>Organize course offerings and see enrolled students.</p></div></div>
<div class="content-two-column">
  <section class="panel course-panel"><div class="panel-heading"><div><h3>Courses</h3><p><%= courses.length %> academic programs</p></div><span class="stat-icon icon-blue"><i data-lucide="library-big"></i></span></div>
    <% if (courses.length) { %><div class="course-list"><% courses.forEach((course) => { %><article class="course-item"><span class="course-avatar"><i data-lucide="book-open"></i></span><span class="course-meta"><strong><%= course.name %></strong><small><%= course.code %> · Added <%= new Date(course.created_at).toLocaleDateString() %></small></span><span class="course-count"><strong><%= course.student_count %></strong><small>students</small></span><% if (!course.student_count) { %><form action="/courses/<%= course.id %>/delete" method="post" data-confirm-delete><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button" type="submit" aria-label="Remove course"><i data-lucide="trash-2"></i></button></form><% } %></article><% }) %></div><% } else { %><div class="empty-state"><span class="empty-icon"><i data-lucide="library-big"></i></span><h3>No courses yet</h3><p>Add your academic programs to assign students.</p></div><% } %>
  </section>
  <section class="panel form-panel"><div class="panel-heading"><div><h3>Add a course</h3><p>Set up an academic program</p></div></div><form action="/courses" method="post" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Course name <b>*</b></span><input name="name" required maxlength="100" placeholder="e.g. Information Technology"></label><label class="field"><span>Course code <b>*</b></span><input name="code" required maxlength="12" placeholder="e.g. BSIT"></label><button class="button button-primary" type="submit"><i data-lucide="plus"></i> Add course</button></form><div class="form-note"><i data-lucide="info"></i> Courses with existing student records cannot be deleted.</div></section>
</div>
<%- include('shell-end') %>
