<%- include('shell-start') %>
<div class="page-heading"><div><span class="eyebrow">PREFERENCES</span><h1>Settings</h1><p>Manage your account and application appearance.</p></div></div>
<div class="settings-grid">
  <section class="panel settings-panel"><div class="panel-heading"><div><h3>Appearance</h3><p>Choose the look that works best for you.</p></div></div><div class="setting-row"><span class="setting-icon"><i data-lucide="moon-star"></i></span><span class="setting-copy"><strong>Dark mode</strong><small>Use a darker interface across the workspace.</small></span><label class="switch"><input type="checkbox" data-theme-switch aria-label="Enable dark mode"><span></span></label></div></section>
  <section class="panel settings-panel"><div class="panel-heading"><div><h3>Administrator account</h3><p>Signed in as <strong><%= username %></strong></p></div><span class="avatar avatar-profile avatar-settings"><%= username.slice(0, 1).toUpperCase() %></span></div><form action="/settings/password" method="post" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Current password <b>*</b></span><input type="password" name="current_password" required autocomplete="current-password"></label><label class="field"><span>New password <b>*</b></span><input type="password" name="new_password" minlength="12" required autocomplete="new-password"><small>Use at least 12 characters.</small></label><button class="button button-primary" type="submit"><i data-lucide="key-round"></i> Update password</button></form></section>
</div>
<%- include('shell-end') %>
