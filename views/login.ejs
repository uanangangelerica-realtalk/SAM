<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#172554">
  <title>Sign in · Campus</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1">
  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script>
  <script src="/app.js?v=1" defer></script>
</head>
<body class="auth-page">
<main class="auth-shell">
  <section class="auth-art">
    <a class="brand brand-light" href="/">
      <span class="brand-mark"><i data-lucide="graduation-cap"></i></span>
      <span class="brand-copy"><strong>campus</strong><small>STUDENT SERVICES</small></span>
    </a>
    <div class="art-copy">
      <span class="eyebrow">A BETTER WAY TO SUPPORT EVERY STUDENT</span>
      <h1>Bring your campus<br>community together.</h1>
      <p>A thoughtful space for the people and possibilities that shape your university.</p>
      <div class="art-orbit orbit-one"></div>
      <div class="art-orbit orbit-two"></div>
      <div class="art-dots"></div>
      <div class="floating-card floating-card-top">
        <span class="floating-icon"><i data-lucide="book-open-check"></i></span>
        <span><strong>Every record, in reach</strong><small>One clear view of your community</small></span>
      </div>
      <div class="floating-card floating-card-bottom">
        <span class="floating-avatars"><b>J</b><b>M</b><b>A</b></span>
        <span><strong>Made for your campus</strong><small>Student-first administration</small></span>
      </div>
    </div>
    <div class="auth-art-footer"><span>Thoughtful tools for thriving communities.</span><span>Secure · Focused · Connected</span></div>
  </section>
  <section class="auth-form-side">
    <div class="auth-mobile-brand"><span class="brand-mark"><i data-lucide="graduation-cap"></i></span><strong>campus</strong></div>
    <div class="auth-card">
      <span class="eyebrow">ADMINISTRATOR PORTAL</span>
      <h2>Welcome Back!</h2>
      <p class="auth-subtitle">Sign in to manage your student records.</p>
      <% if (error) { %>
        <div class="auth-error" role="alert"><i data-lucide="circle-alert"></i><span><%= error %></span></div>
      <% } %>
      <form action="/login" method="post" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field">
          <span>Administrator username</span>
          <div class="input-with-icon"><i data-lucide="user-round"></i><input name="username" required autocomplete="username" placeholder="Enter your username" autofocus></div>
        </label>
        <label class="field">
          <span>Password</span>
          <div class="input-with-icon">
            <i data-lucide="lock-keyhole"></i>
            <input id="login-password" name="password" type="password" required autocomplete="current-password" placeholder="Enter your password">
            <button class="password-toggle" type="button" data-password-toggle aria-label="Show password"><i data-lucide="eye"></i></button>
          </div>
        </label>
        <div class="auth-options"><label class="checkbox-label"><input type="checkbox" name="remember" value="1"><span>Remember me</span></label></div>
        <button class="button button-primary auth-submit" type="submit"><span>Sign in to Campus</span><i data-lucide="arrow-right"></i></button>
      </form>
      <div class="auth-security"><i data-lucide="shield-check"></i><span>Your information is protected with secure sign-in.</span></div>
    </div>
    <footer class="auth-footer">
      <span>© <%= new Date().getFullYear() %> Campus Student Services</span>
      <button class="icon-button theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle><i data-lucide="moon"></i></button>
    </footer>
  </section>
</main>
</body>
</html>
