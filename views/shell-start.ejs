<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#172554">
  <title><%= title %> · Campus</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1">
  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" defer></script>
  <script src="/app.js?v=1" defer></script>
</head>
<body>
<div class="app-shell">
  <aside class="sidebar" id="sidebar" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="Campus home">
      <span class="brand-mark"><i data-lucide="graduation-cap"></i></span>
      <span class="brand-copy"><strong>campus</strong><small>STUDENT SERVICES</small></span>
    </a>
    <div class="nav-caption">WORKSPACE</div>
    <nav class="nav-list">
      <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/"><i data-lucide="layout-dashboard"></i><span>Overview</span></a>
      <a class="nav-link <%= currentPath.startsWith('/students') && currentPath !== '/students/new' ? 'active' : '' %>" href="/students"><i data-lucide="contact-round"></i><span>Student records</span></a>
      <a class="nav-link nav-link-sub <%= currentPath === '/students/new' ? 'active' : '' %>" href="/students/new"><i data-lucide="user-round-plus"></i><span>Add student</span></a>
      <a class="nav-link <%= currentPath === '/courses' ? 'active' : '' %>" href="/courses"><i data-lucide="library-big"></i><span>Courses</span></a>
      <a class="nav-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>" href="/reports"><i data-lucide="chart-no-axes-combined"></i><span>Reports & analytics</span></a>
    </nav>
    <div class="nav-caption nav-caption-spaced">PREFERENCES</div>
    <nav class="nav-list">
      <a class="nav-link <%= currentPath === '/settings' ? 'active' : '' %>" href="/settings"><i data-lucide="settings-2"></i><span>Settings</span></a>
    </nav>
    <div class="sidebar-bottom">
      <div class="sidebar-tip">
        <span class="tip-icon"><i data-lucide="sparkles"></i></span>
        <strong>Made for better<br>student experiences.</strong>
        <span>Everything in one place.</span>
      </div>
      <div class="user-card">
        <span class="avatar avatar-small"><%= (user.username || 'A').slice(0, 1).toUpperCase() %></span>
        <span class="user-meta"><strong><%= user.username %></strong><small>Administrator</small></span>
        <form action="/logout" method="post" class="logout-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="icon-button logout-button" aria-label="Log out" title="Log out"><i data-lucide="log-out"></i></button>
        </form>
      </div>
    </div>
  </aside>
  <div class="sidebar-scrim" data-close-menu></div>
  <main class="main-shell">
    <header class="topbar">
      <button class="icon-button mobile-menu" type="button" aria-label="Open navigation" data-menu-toggle><i data-lucide="menu"></i></button>
      <div class="topbar-heading"><span>Campus / <%= title %></span><strong><%= title %></strong></div>
      <div class="topbar-actions">
        <button class="icon-button desktop-collapse" type="button" aria-label="Collapse navigation" data-sidebar-collapse><i data-lucide="panel-left-close"></i></button>
        <a class="top-search" href="/students?focus=1" aria-label="Search student records"><i data-lucide="search"></i><span>Search records</span><kbd>⌘ K</kbd></a>
        <button class="icon-button theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle><i data-lucide="moon"></i></button>
        <details class="profile-menu"><summary><span class="avatar avatar-top"><%= (user.username || 'A').slice(0, 1).toUpperCase() %></span><span class="profile-menu-copy"><strong><%= user.username %></strong><small>Administrator</small></span><i data-lucide="chevron-down"></i></summary><div class="profile-popover"><a href="/settings"><i data-lucide="settings-2"></i> Account settings</a><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><i data-lucide="log-out"></i> Log out</button></form></div></details>
      </div>
    </header>
    <section class="page-content">
      <% if (flash) { %>
        <div class="toast toast-<%= flash.type %>" role="status"><i data-lucide="<%= flash.type === 'error' ? 'circle-alert' : 'circle-check' %>"></i><span><%= flash.message %></span><button class="toast-close" aria-label="Dismiss notification" type="button">×</button></div>
      <% } %>
