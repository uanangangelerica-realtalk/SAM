    </section>
  </main>
</div>
<dialog class="confirm-dialog" id="confirm-dialog">
  <form method="dialog" class="confirm-content">
    <span class="confirm-icon"><i data-lucide="triangle-alert"></i></span>
    <h2>Delete this record?</h2>
    <p>This action is permanent and cannot be undone.</p>
    <div class="button-row"><button class="button button-quiet" value="cancel">Cancel</button><button class="button button-danger" value="confirm">Delete record</button></div>
  </form>
</dialog>
</body>
</html>
